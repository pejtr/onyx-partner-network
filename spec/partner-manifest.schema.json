{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pejtr/onyx-partner-network/spec/partner-manifest.schema.json",
  "title": "ONYX Partner Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "partner_id",
    "display_name",
    "website",
    "categories",
    "integration"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "partner_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "countries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "affiliate-link",
              "api",
              "webhook",
              "mcp"
            ]
          }
        },
        "docs_url": {
          "type": "string",
          "format": "uri"
        },
        "mcp_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "enum": [
            "affiliate",
            "revenue-share",
            "cpa",
            "cpl",
            "hybrid",
            "negotiated"
          ]
        },
        "public_terms_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partnership_url": {
          "type": "string",
          "format": "uri"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    }
  }
}
